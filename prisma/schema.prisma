generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              BigInt         @id // Telegram User ID
  firstName       String
  lastName        String?
  username        String?
  photoUrl        String?
  photoFileId    String?   // Telegram file_id for bot users (avatar proxied via /api/avatar)
  phoneNumber     String?
  // How this person prefers to receive transfers:
  // payBank builds an SBP link from the phone; payLink is their own ready link
  // (Alfa & co. hand out c2c.cbrpay.ru/<id>, which cannot be generated)
  payBank         String?
  payLink         String?
  items           OrderItem[]
  initiatedOrders OrderSession[] @relation("AdminRelation")
  authTokens      AuthToken[]
  payments        Payment[]
  participations  Participant[]
  reminders       PaymentReminder[]
}

model OrderSession {
  id              String      @id @default(cuid())
  url             String
  // Which branch of the restaurant the menu came from. Brand links
  // (/{city}/r/{brand}) have several branches with different menus & prices.
  placeSlug       String?
  placeName       String?
  placeAddress    String?
  // Conditions of this order people must keep in mind: a discount capped per
  // order, a minimum, a promo code. Written by whoever is paying.
  conditions      String?
  // Which menu parser produced the cached menu. A newer parser repairs it.
  menuVersion     Int         @default(0)
  placeOptions    Json? // other branches to choose from: [{slug,name,address}]
  status          String      @default("OPEN")
  deadlineAt      DateTime? // orders are collected until this moment
  deliveryFee     Decimal     @default(0) @db.Decimal(10, 2)
  serviceFee      Decimal     @default(0) @db.Decimal(10, 2)
  // Prices are kept in the currency the delivery service charges in
  currency        String      @default("RUB")
  discountPercent Int         @default(0)
  adminId         BigInt
  admin           User        @relation("AdminRelation", fields: [adminId], references: [id])
  items           OrderItem[]
  menuItems       MenuItem[]
  payments        Payment[]
  participants    Participant[]
  reminders       PaymentReminder[]
  createdAt       DateTime    @default(now())
}

// "I'm done choosing" marks, so everyone sees who is still picking dishes
model Participant {
  id        String       @id @default(cuid())
  sessionId String
  session   OrderSession @relation(fields: [sessionId], references: [id])
  userId    BigInt
  user      User         @relation(fields: [userId], references: [id])
  readyAt   DateTime     @default(now())

  @@unique([sessionId, userId])
}

// Nudges for participants who haven't marked their transfer yet
model PaymentReminder {
  id        String       @id @default(cuid())
  sessionId String
  session   OrderSession @relation(fields: [sessionId], references: [id])
  userId    BigInt
  user      User         @relation(fields: [userId], references: [id])
  amount    Decimal      @db.Decimal(10, 2)
  nextAt    DateTime // when to send the next nudge
  sentCount Int          @default(0)
  doneAt    DateTime? // set when the user finally taps "I paid"
  createdAt DateTime     @default(now())

  @@unique([sessionId, userId])
  @@index([doneAt, nextAt])
}

model MenuItem {
  id          String       @id @default(cuid())
  sessionId   String
  session     OrderSession @relation(fields: [sessionId], references: [id])
  category    String
  categoryOrder Int      @default(0) // Yandex's own category order
  name        String
  price       Decimal      @db.Decimal(10, 2)
  // What the dish cost before the service's own discount, when it has one
  oldPrice    Decimal?     @db.Decimal(10, 2)
  // Built-to-order dishes have no price until the options are picked
  priceOnSelection Boolean @default(false)
  description String?
  weight      String?
  imageUrl    String?
  optionsJson Json? // option groups from Yandex Eda (spiciness, sauces, drinks, ...)
}

model OrderItem {
  id        String       @id @default(cuid())
  sessionId String
  session   OrderSession @relation(fields: [sessionId], references: [id])
  userId    BigInt
  user      User         @relation(fields: [userId], references: [id])
  dishName  String
  price     Decimal      @db.Decimal(10, 2)
  options   String? // chosen options, human-readable ("Соус: Сырный · Напиток: Кола")
}

// "I have paid" marks per participant per order session
model Payment {
  id        String       @id @default(cuid())
  sessionId String
  session   OrderSession @relation(fields: [sessionId], references: [id])
  userId    BigInt
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([sessionId, userId])
}

model AuthToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    BigInt?
  user      User?    @relation(fields: [userId], references: [id])
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
}
