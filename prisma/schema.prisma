generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              BigInt         @id // Telegram User ID
  firstName       String
  lastName        String?
  username        String?
  photoUrl        String?
  photoFileId    String?   // Telegram file_id for bot users (avatar proxied via /api/avatar)
  phoneNumber     String?
  items           OrderItem[]
  initiatedOrders OrderSession[] @relation("AdminRelation")
  authTokens      AuthToken[]
  payments        Payment[]
}

model OrderSession {
  id              String      @id @default(cuid())
  url             String
  // Which branch of the restaurant the menu came from. Brand links
  // (/{city}/r/{brand}) have several branches with different menus & prices.
  placeSlug       String?
  placeName       String?
  placeAddress    String?
  placeOptions    Json? // other branches to choose from: [{slug,name,address}]
  status          String      @default("OPEN")
  deliveryFee     Int         @default(0)
  serviceFee      Int         @default(0)
  discountPercent Int         @default(0)
  adminId         BigInt
  admin           User        @relation("AdminRelation", fields: [adminId], references: [id])
  items           OrderItem[]
  menuItems       MenuItem[]
  payments        Payment[]
  createdAt       DateTime    @default(now())
}

model MenuItem {
  id          String       @id @default(cuid())
  sessionId   String
  session     OrderSession @relation(fields: [sessionId], references: [id])
  category    String
  name        String
  price       Int
  description String?
  weight      String?
  imageUrl    String?
  optionsJson Json? // option groups from Yandex Eda (spiciness, sauces, drinks, ...)
}

model OrderItem {
  id        String       @id @default(cuid())
  sessionId String
  session   OrderSession @relation(fields: [sessionId], references: [id])
  userId    BigInt
  user      User         @relation(fields: [userId], references: [id])
  dishName  String
  price     Int
  options   String? // chosen options, human-readable ("Соус: Сырный · Напиток: Кола")
}

// "I have paid" marks per participant per order session
model Payment {
  id        String       @id @default(cuid())
  sessionId String
  session   OrderSession @relation(fields: [sessionId], references: [id])
  userId    BigInt
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([sessionId, userId])
}

model AuthToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    BigInt?
  user      User?    @relation(fields: [userId], references: [id])
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
}
